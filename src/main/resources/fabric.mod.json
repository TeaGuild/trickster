{
    "schemaVersion": 1,
    "id": "trickster",
    "version": "${version}",
    "name": "Trickster",
    "description": "A mod about magic, creativity, and trickery.",
    "authors": [
        {
            "name": "enjarai",
            "contact": {
                "homepage": "https://enjarai.dev"
            }
        },
        {
            "name": "aurakle",
            "contact": {
                "email": "trickster@aurakle.dev",
                "homepage": "https://aurakle.dev"
            }
        }
    ],
    "contributors": [
        "BlueMoonJune",
        "AshAxolotl"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/trickster",
        "sources": "https://codeberg.org/trans-fish/trickster",
        "issues": "https://codeberg.org/trans-fish/trickster/issues"
    },
    "license": "MIT",
    "icon": "assets/trickster/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.enjarai.trickster.Trickster"
        ],
        "client": [
            "dev.enjarai.trickster.TricksterClient"
        ],
        "fabric-datagen": [
            "dev.enjarai.trickster.datagen.ModDataStuff"
        ],
        "cardinal-components-chunk": [
            "dev.enjarai.trickster.cca.ModChunkComponents"
        ],
        "cardinal-components-scoreboard": [
            "dev.enjarai.trickster.cca.ModGlobalComponents"
        ],
        "cardinal-components-world": [
            "dev.enjarai.trickster.cca.ModWorldComponents"
        ],
        "cardinal-components-entity": [
          "dev.enjarai.trickster.cca.ModEntityComponents"
        ],
        "cicada": [
            "dev.enjarai.trickster.Trickster"
        ]
    },
    "custom": {
        "cardinal-components": [
            "trickster:caster",
            "trickster:bars",
            "trickster:flecks",
            "trickster:ward",
            "trickster:shared_mana",
            "trickster:message_handler",
            "trickster:disguise",
            "trickster:is_editing_scroll",
            "trickster:pinned_chunks",
            "trickster:grace",
            "trickster:mana_handler",
            "trickster:player_animation",
            "trickster:weight",
            "trickster:scale",
            "trickster:displacement",
            "trickster:curse",
            "trickster:server_player_velocity"
        ]
    },
    "mixins": [
        "trickster.mixins.json",
        {
            "config": "trickster.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": ">=1.21",
        "java": ">=21",
        "fabric-api": "*",
        "owo": ">=0.13.0-alpha.15",
        "lavender": "*",
        "accessories": ">=1.0.0-beta.11",
        "lithostitched": ">=1.7.3-fabric-21.1",
        "cicada": ">=0.8.2"
    },
    "recommends": {
        "inline": "^1.2.2"
    },
    "conflicts": {
        "immediatelyfast": "*",
        "supplementaries": "*"
    },
    "breaks": {
        "optifabric": "*"
    }
}
